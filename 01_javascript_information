// Comments can be recorded using two slashe
print('Hello World')

// Variables are used to store objects, and are defined using the keyword var.
var the_answer = 42; //number

var city = 'San Francisco'; // creates a variable called city
print (city); // print value of city variable

var population = 873965;
print (population);
print('The value for the population variable is:', population);

// Useful to make lists, stores multiple values in a single container  variable
var cities = ['San Francisco', 'Los Angeles', 'New York', 'Atlanta'];
print (cities);

// Objects allow you to store key-value pairs. Create a directory using curly braces
var cityData = {
    'city': 'San Francisco',
    'coordinates': [-122.4194, 37.7749],
    'population': 873965
};
print(cityData);

// Functions can be defined as a way to reuse code and make it easier to read
var my_hello_function = function(string) {
  return 'Hello ' + string + '!';
};
print(my_hello_function('world'));

// Another example:
var greet = function(name) {
    return 'Hello ' + name;
};
print(greet('World'));
print(greet('Readers'));
print(greet('Everyone'));