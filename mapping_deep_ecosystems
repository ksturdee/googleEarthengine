// Task: build a map of the world's major deep ocean ecosystems

// ETOPO1 dataset will be used, specifically the bedrock band. This dataset is a 1 
// arc-minute global relief model of Earth''s surface that integrates land topography 
// and ocean bathymetry. Bedrock band: min: -10898 m	max: 8271	resolution: 1855 meters	m

// The goal is to map...
// Hadal trenches and troughs (>6000m)
// Abyssal plains (3000-6000m)
// Continental and island slopes (250-3000m)
// Submarine canyons (deeper than 200m, slopes of >6 degrees)

// ...with adding at least one vector dataset


Map.setOptions('HYBRID');

// Load and inspect ETOPO1
var ETOPO1 = ee.Image("NOAA/NGDC/ETOPO1")
print(ETOPO1);

// Select bedrock band
var bedrock = ee.Image('NOAA/NGDC/ETOPO1').select('bedrock');
print(bedrock)

// Bathymetric palette: deepest ocean to shallow coastal waters
var bathymetryPalette = [
  '#080C3B', // -10,898 m: Deepest hadal trenches
  '#172A68', //  -9,000 m: Hadal zone
  '#253494', //  -7,000 m: Deep trenches
  '#225EA8', //  -5,000 m: Abyssal plains
  '#1D91C0', //  -3,000 m: Continental slope
  '#41B6C4', //  -2,000 m: Continental slope
  '#7FCDBB', //  -1,000 m: Upper slope
  '#C7E9B4'  //       0 m: Shallow coastal waters
];

// Add the bedrock object to the map
Map.addLayer(bedrock, {
    min: -10898, // Deepest value in meters (adjust to your region)
    max: 8271,     // Sea level
    palette: bathymetryPalette}, 
  'ETOPO1 Bedrock Bathymetry', false);

// Bathymetry is everywhere, limit analysis to the ocean...
var ocean = bedrock.lt(0).selfMask(); // create binary where 1 = ocean, 0 = land. 
// lt() identifies ocean pixels, .selfMask() hides land pixels = 0
print(ocean); // this just makes a binary image between land and ocean, must make ocean mask

// View ocean bathymetry without covering land
var oceanBathymetry = bedrock.updateMask(ocean); // update mask retains original depth vales
Map.addLayer(oceanBathymetry, {min: -10898, max: 0, palette: bathymetryPalette}, 'Ocean Bathymetry', false);

// build raster map of each ecosystem
// define hadal trenches >6000m
var hadal = bedrock.lt(-6000).selfMask();
print('Hadal trenches and troughs', hadal);
Map.addLayer(hadal, {palette: ['#08142C']}, 'Hadal trenches');

// define abyssal plains, 3000-6000m
var abyssal = bedrock.gt(-6000)
  .and(bedrock.lt(-3000))
  .selfMask();
print('Abyssal plains', abyssal);
Map.addLayer(abyssal, {palette: ['#0F3460']}, 'Abyssal plains');

// define continental and island slopes 250-3000m
var contSlopes = bedrock.gt(-3000)
  .and(bedrock.lt(-250))
  .selfMask();
print('Continental and island slopes', contSlopes)
Map.addLayer(contSlopes, {palette: ['#2766A8']}, 'Continental and island slopes');

// repeat for submarine canyons (deeper than 200 with slopes of >6 degrees)
var slope = ee.Terrain.slope(bedrock);
print('seabed slope', slope);
// inspect on a map
Map.addLayer(slope, {min: 0, max: 30, palette: ['#FEF001', '#FFCE03', '#FD9A01', '#FD6104']}, 'Seabed slope', false);

var submarine = bedrock.lt(-200)
  .and(slope.gt(6))
  .selfMask();
print('Submarine canyons', submarine)
Map.addLayer(submarine, {palette: ['#D95F0E']}, 'Submarine canyons');

// Import deep-sea mining exploration areas from dataset 
// Dataset: International Seabed Authority (ISA);  
// Source: https://www.isa.org.jm/deepdata-database/maps/

// This vector dataset contains polygon boundaries of areas
// allocated for polymetallic nodule exploration, which occurs on
// the seafloor especially in abyssal environments. For this dataset,
// the polygons represent exploration contract areas,
// not necessarily locations where commercial seabed mining is actively occurring;
// however it is still a useful proxy to investigate where deep sea exploration
// is occuring. 

// Import ISA exploration polygons from my Earth Engine assets
var miningAreas = ee.FeatureCollection(
  'projects/coastlines-512607/assets/ISA_PolymetallicNodule_ExplorationAreas'
);
print ('ISA polymetallic nodule exploration areas', miningAreas); // Feature collection

// Display exploration boundaries
Map.addLayer(miningAreas.style({
  color: '#F2C66D',      // Gold polygon boundaries
  fillColor: '#F2C66D15', // Very transparent gold fill
  width: 2               // Boundary width in pixels
  }), {},'ISA polymetallic nodule exploration areas');


// Add marine protected areas (Dataset: World Database on Protected Areas (WDPA))
// This dataset contains protected area boundaries from around the world, 
// and uses 0 = terrestrial, 1 = coastal (marine and terrestrial), and 
// 2 = entirely marine.

var WDPA = ee.FeatureCollection("WCMC/WDPA/current/polygons")
print(WDPA);

// Filter to entirely marine protected areas
var marineProtectedAreas = WDPA
  .filter(ee.Filter.inList('MARINE and COASTAL', ['1', '2']));

// Inspect the filtered dataset
print('First marine protected area', marineProtectedAreas.first());

// Display marine protected area boundaries in turquoise
// Keep this layer switched off initially to avoid clutter
Map.addLayer(marineProtectedAreas.style({color: '#58D6C7', fillColor: '#58D6C710',
    width: 1}), {}, 'Marine protected areas', true);









