// Visualising 
Map.setOptions('SATELLITE')

// Import data
// Note for this dataset the resolution is around 90 m 
var srtm = ee.Image("CGIAR/SRTM90_V4") // obtain snippet from search bar
print(srtm)
Map.addLayer(srtm, {
  palette: ['2c5e3b', 'a9ba7d', 'dec68a', '8c684d', 'b0a9a4', 'ffffff'], 
  min: 0, 
  max: 2500}, 'srtm'); // Topography layer from forest green (0m) to snow white (3000m)

// Imagining an error where dataset is recorded 10 m off. Let's fix it

var srtm_fixed = srtm.add(10) // adds 10 m to every pixel
Map.addLayer(srtm_fixed, {
  palette: ['2c5e3b', 'a9ba7d', 'dec68a', '8c684d', 'b0a9a4', 'ffffff'], 
  min: 0, 
  max: 2500}, 'srtm_fixed'); // loads the corrected map
  
// Thresholding images
// Pick a threshold for the snowline 

var snow_line = srtm.gt(1800) // sets the threshold for greater than 1800 m
Map.addLayer(snow_line, {palette: ['black','e']}, 'snow threshold')


