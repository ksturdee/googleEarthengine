// Visualising 
Map.setOptions('SATELLITE')
Map.setCenter(174.0638, -39.2891, 11)

// Import data
// Note for this dataset the resolution is around 90 m 
var srtm = ee.Image("CGIAR/SRTM90_V4") // obtain snippet from search bar
print(srtm)
Map.addLayer(srtm, {
  palette: ['2c5e3b', 'a9ba7d', 'dec68a', '8c684d', 'b0a9a4', 'ffffff'], 
  min: 0, 
  max: 2500}, 'srtm'); // Topography layer from forest green (0m) to snow white (3000m)

// Imagining an error where dataset is recorded 10 m off. Let's fix it

// var srtm_fixed = srtm.add(10) // adds 10 m to every pixel
// Map.addLayer(srtm_fixed, {
//   palette: ['2c5e3b', 'a9ba7d', 'dec68a', '8c684d', 'b0a9a4', 'ffffff'], 
//   min: 0, 
//   max: 2500}, 'srtm_fixed'); // loads the corrected map
  
// Thresholding images
// Pick a threshold for the snowline 

var snow_line = srtm.gt(1800).selfMask() // sets the threshold for greater than 1800 m
var tree_line = srtm.gt(1015).selfMask(); // likewise a threshold for 1015
Map.addLayer(tree_line, {palette: ['black','#5D722C']}, 'tree threshold')
Map.addLayer(snow_line, {palette: ['black','white']}, 'snow threshold')


// COMPLEX IMAGE FUNCTIONS

var slope = ee.Terrain.slope(srtm) // This shows us degrees of slope, can pick out hillsides, can distinguish between drop-offs versus gradual change
Map.addLayer(slope, {palette: ['111e38', '24416b', '3f6c91', '689bb5', 'a5ccd1', 'e2f1ec']}, 'slope')

// Region reducers
// Interested in the average slope of the national park
var protected_areas = (ee.FeatureCollection("WCMC/WDPA/current/polygons")) // Load boundaries
var taranaki = protected_areas.filter(ee.Filter.eq('NAME', 'Egmont National Park'));
Map.addLayer(taranaki, {color: 'orange'}, 'Mt Taranaki') // Adds Mt Taranaki protected area map

// Apply a spatial reducer to estimate mean slope
var slopeOutput = slope.reduceRegion ({
  reducer: ee.Reducer.mean(), // finds mean of all slope pixel values in the park
  geometry: taranaki,
  scale:90 // pixel size in m from dataset metadata
})
print('slopeOutput', slopeOutput) // Slope: 10.041806454483673 m

// Sanity check by clipping to see if you get the same answer
var taranakiSlope = slope.clip(taranaki)
Map.addLayer(taranakiSlope, {palette: ['white', 'darkred', 'black'], min:0, max:45}, 'taranaki slope')

var slopeOutput2 = taranakiSlope.reduceRegion({
  reducer: ee.Reducer.mean(), // we compute the mean of all slope pixel values in the national park
  geometry: taranaki,
  scale:90 // pixel size in metres - get this from the metadata (ie. search for it)
})
print ('slopeOutput2', slopeOutput2) // same answer: 10.041806454483673

// Calculate the maximum and minimum elevation of the park. Reduce regions with a different reducer (Max)
var elevOutput_Max = srtm.reduceRegion({
  reducer: ee.Reducer.max(), // find max of all pixels within the national park 
  geometry: taranaki,
  scale: 90 // again, pixel size in m from metadata
})
  print('elevOutput_Max', elevOutput_Max) // Max elevation: 2484
  
// Repeat for minimum
var elevOutput_Min = srtm.reduceRegion({
  reducer: ee.Reducer.min(), // find min of all pixels within the national park 
  geometry: taranaki,
  scale: 90 // again, pixel size in m from metadata
})
  print('elevOutput_Min', elevOutput_Min) // Minimum elevation: 108
  
// Use reduce regions with a different reducer, SAME OUTPUT but more efficient route
var elevOutput_MinMax = srtm.reduceRegion({
  reducer: ee.Reducer.minMax(), // we compute the mean of all slope pixel values in the national park
  geometry: taranaki,
  scale:90 // pixel size in metres - get this from the metadata (ie. search for it)
})
print ('elevOutput_MinMax', elevOutput_MinMax)

