// The purpose of this analysis is to determine which research station we should
// spend a limited buget on by finding the best balance between maximizing the
// amount of coral accessible from shore. In this scenario, we are allowed to
// snorkel 800 m from shore. This script uses the Allan Coral Atlans benthc cover
// map. 

// Set map options to start
Map.setOptions('SATELLITE')
Map.setCenter( 151.914, -23.441, 15) // zoom over Heron Island

 
// Global variables - data imports and any constants
var distance = 800 // (m) allowed snorkelling distance from shore

// Research station locations 
// Mark their locations on the map using coordinates. Then make a featureCollection

// Make a geometry (vector) of locations; create point features given coordinates
var field_stations = ee.FeatureCollection([Heron, Hamilton, Daydream, Lizard, Orpheus, OneTree, Moorea, Smithsonian])
print(field_stations);

// ACA operations - ACA set
// Import Allen Coral Atlas data. Note this dataset has 5m pixel resolution. Underlyng images data are
// temporal composites from 2018-2020. We are interested in the benthic band.
var ACA = ee.Image("ACA/reef_habitat/v2_0")
print(ACA);

Map.addLayer(ACA, {}, 'ACA', false);

var benthic = ee.Image("ACA/reef_habitat/v2_0").select('benthic')
print(benthic);

Map.addLayer(benthic, {}, 'Benthic Habitat', false);

// Make binary image where 1 = coral/algae and 0 = everything else
var coraloralgae = benthic.eq(15).selfMask(); // make image where each pixel is coral or algae
print(coraloralgae);

Map.addLayer(coraloralgae, {palette: ['ff6161']}, 'Coral and Algae', false) // shows only coral and algae

// Buffer features to clip coral raster to a distance surrounding each station.

// var bufferedHeron = ee.Feature(field_stations.first())
// print(bufferedHeron);

// To buffer all of the field stations, must use .map() for a loop

var bufferer = function (feature) {
  var buffered = feature.buffer(800) // 800 m
  return buffered;
}
var bufferedStations = field_stations.map(bufferer) // use .map to work one station at a time
print(bufferedStations);

Map.addLayer(bufferedStations, {color: 'yellow'}, 'Buffered Stations', true); // generates a buffer of 800m radius)

